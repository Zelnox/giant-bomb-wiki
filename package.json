{
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.0"
  },
  "devDependencies": {
    "@prettier/plugin-php": "github:prettier/plugin-php",
    "@types/jest": "^30.0.0",
    "cypress": "^16.1.1",
    "cypress-dotenv": "^3.0.1",
    "dotenv": "^18.0.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "format": "pnpm prettier --write --config .prettierrc 'README.md|*.json|*.yaml|*.yml|(skins|cypress|.github|extensions)/**/*.{css,js,json,ts,vue,yaml,yml}|extensions/GbSessionProvider/**/*.php'",
    "format:check": "pnpm prettier --check --config .prettierrc 'README.md|*json|*.yaml|*.yml||(skins|cypress|.github)/**/*.{css,js,json,ts,vue,yaml,yml}|extensions/GbSessionProvider/**/*.php'",
    "test:e2e": "pnpm cypress run",
    "test:unit": "jest"
  }
}
